from os import PathLike
from typing import Any, AsyncIterator, Iterable, List, Optional, Sequence, Tuple, Union

from . import (
    Cell,
    CollectionDescription,
    CollectionInfo,
    Key,
    Param,
    Result,
    Row,
    Vector,
)

async def open(path: Union[str, "PathLike[str]"], *, salvage: bool = ...) -> "AsyncDatabase": ...

class AsyncCursor:
    columns: Tuple[str, ...]
    @property
    def closed(self) -> bool: ...
    def close(self) -> None: ...
    def __aiter__(self) -> AsyncIterator[Tuple[Cell, ...]]: ...
    async def __anext__(self) -> Tuple[Cell, ...]: ...
    async def __aenter__(self) -> "AsyncCursor": ...
    async def __aexit__(self, *exc: Any) -> None: ...

class AsyncDatabase:
    @property
    def closed(self) -> bool: ...
    async def close(self) -> None: ...
    async def execute(self, sql: str, params: Sequence[Param] = ...) -> Result: ...
    async def query(self, sql: str, params: Sequence[Param] = ..., *, chunk_rows: int = ...) -> AsyncCursor: ...
    async def search(
        self,
        collection: str,
        vector: Vector,
        k: int = ...,
        *,
        where: Optional[str] = ...,
        params: Sequence[Param] = ...,
        returning: Optional[Sequence[str]] = ...,
    ) -> Result: ...
    async def insert(self, collection: str, rows: Iterable[Row]) -> int: ...
    async def upsert(self, collection: str, rows: Iterable[Row]) -> int: ...
    async def get(self, collection: str, key: Key) -> Optional[dict[str, Cell]]: ...
    async def delete(self, collection: str, key: Key) -> None: ...
    async def collections(self) -> List[CollectionInfo]: ...
    async def describe(self, collection: str) -> CollectionDescription: ...
    async def backup(self, dest: Union[str, "PathLike[str]"]) -> None: ...
    def interrupt(self) -> None: ...
    def set_timeout(self, seconds: Optional[float]) -> None: ...
